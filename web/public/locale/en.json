    "advancedRouting": {
      "title": "Advanced Routing",
      "hint": "No new group modes — soft re-rank on top of round-robin/random/failover/weighted. Health score on by default; semantic routing off.",
      "saved": "Saved",
      "healthScore": {
        "label": "Health-score routing",
        "tip": "Blend probe status + passive EWMA latency + success rate to prefer healthier channels. Failover still respects Priority."
      },
      "semantic": {
        "label": "Semantic/complexity routing",
        "tip": "Rule-based (no embedding): complex requests (long text / coding) prefer higher-Weight channels. Does not replace Weighted mode."
      },
      "stream": {
        "title": "Stream log memory cap",
        "maxEvents": "Max retained events",
        "maxEventsTip": "0 = pass-through only (no full stream for logs). Default 32; long chats keep only the tail.",
        "maxBytes": "Max retained bytes",
        "maxBytesTip": "0 = none. Default 65536. Overflow drops oldest events; usage is usually at the end."
      },
      "netObs": {
        "label": "Network observation backend",
        "tip": "auto=prefer eBPF (fallback to Go), go=pure Go, ebpf=force kernel. auto falls back when CAP_BPF is missing.",
        "options": {
          "auto": "auto (recommended)",
          "go": "pure Go",
          "ebpf": "force eBPF"
        },
        "runtimeHint": "Restart required after change. Live backend shows on home health badge (Go / eBPF)."
      }
    },
